#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."
plugin="${1:?usage: scripts/check-plugin <plugin>}"
plugin_dir="plugins/$plugin"
manifest="$plugin_dir/backend/Cargo.toml"

python3 scripts/plugin-repo.py meta "$plugin" id >/dev/null

echo "==> checking $plugin"
cargo fmt --manifest-path "$manifest" --check
RUST_MIN_STACK="${RUST_MIN_STACK:-16777216}" \
  cargo clippy --manifest-path "$manifest" --all-targets --all-features -- -D warnings
RUST_MIN_STACK="${RUST_MIN_STACK:-16777216}" \
  cargo test --manifest-path "$manifest"

frontend_mode="$(python3 scripts/plugin-repo.py meta "$plugin" frontend_mode)"
case "$frontend_mode" in
  pnpm)
    corepack enable
    pnpm --dir "$plugin_dir/frontend" install --frozen-lockfile
    if node -e 'const p=require(process.argv[1]); process.exit(p.scripts?.lint ? 0 : 1)' "$plugin_dir/frontend/package.json"; then
      pnpm --dir "$plugin_dir/frontend" run lint
    fi
    if node -e 'const p=require(process.argv[1]); process.exit(p.scripts?.build ? 0 : 1)' "$plugin_dir/frontend/package.json"; then
      pnpm --dir "$plugin_dir/frontend" run build
    fi
    ;;
  static)
    if [[ -f "$plugin_dir/frontend/app.js" ]]; then
      node --check "$plugin_dir/frontend/app.js"
    fi
    ;;
  none) ;;
  *) echo "未知 frontend mode: $frontend_mode" >&2; exit 1 ;;
esac
