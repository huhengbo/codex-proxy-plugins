{
  "manifestVersion": 1,
  "name": "quota-sync",
  "displayName": "额度联动",
  "publisher": "huhengbo",
  "version": "0.1.0",
  "description": "监控 OpenAI 账号周额度重置，并同步关联 Client Key 的周额度账本",
  "license": "Apache-2.0",
  "author": "huhengbo",
  "engines": {
    "codex-proxy-rs": ">=3.16.0, <4.0.0"
  },
  "main": "bin/plugin",
  "runtime": "trustedProcess",
  "contributes": {
    "maintenance": {}
  },
  "permissions": [
    "data"
  ],
  "configurationSchema": {
    "type": "object",
    "properties": {
      "dryRun": {
        "type": "boolean",
        "default": true,
        "description": "仅检测并记录重置事件，不实际重置 Client Key"
      },
      "mappings": {
        "type": "array",
        "default": [],
        "maxItems": 100,
        "description": "OpenAI 账号与需要同步额度的 Client Key 映射",
        "items": {
          "type": "object",
          "required": ["accountId", "clientKeyIds"],
          "properties": {
            "accountId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "clientKeyIds": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "quotaWindowKey": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "description": "可选；当同一账号存在多个 7 天窗口时用于明确选择窗口"
            }
          },
          "additionalProperties": false
        }
      },
      "weeklyWindowSeconds": {
        "type": "integer",
        "minimum": 1,
        "maximum": 2678400,
        "default": 604800,
        "description": "周额度窗口长度，默认 604800 秒"
      },
      "maxObservationAgeSeconds": {
        "type": "integer",
        "minimum": 60,
        "maximum": 86400,
        "default": 1800,
        "description": "超过该时间的额度观测不参与重置判断"
      },
      "boundaryGraceSeconds": {
        "type": "integer",
        "minimum": 0,
        "maximum": 3600,
        "default": 300,
        "description": "正常重置边界判断允许的时间误差"
      },
      "earlyResetDropPercent": {
        "type": "number",
        "minimum": 0,
        "maximum": 100,
        "default": 50,
        "description": "未到正常边界时，识别活动/提前恢复所需的最低用量下降百分点"
      },
      "postResetMaxUsedPercent": {
        "type": "number",
        "minimum": 0,
        "maximum": 100,
        "default": 25,
        "description": "候选重置样本允许的最大已用比例"
      },
      "confirmationGrowthPercent": {
        "type": "number",
        "minimum": 0,
        "maximum": 100,
        "default": 20,
        "description": "第二个确认样本相对候选样本允许增长的百分点"
      }
    },
    "additionalProperties": false
  },
  "state": [
    {
      "namespace": "quota_sync",
      "schemaVersion": 1,
      "schema": {
        "type": "object",
        "required": ["accounts", "events", "updatedAtMs"],
        "properties": {
          "accounts": {
            "type": "array",
            "maxItems": 100,
            "items": { "type": "object" }
          },
          "events": {
            "type": "array",
            "maxItems": 64,
            "items": { "type": "object" }
          },
          "updatedAtMs": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "maximumRecords": 1,
      "maximumBytes": 262144,
      "maximumValueBytes": 262144,
      "migratesFrom": []
    }
  ]
}
