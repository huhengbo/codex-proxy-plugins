{
  "manifestVersion": 1,
  "name": "quota-sync",
  "displayName": "额度联动",
  "publisher": "huhengbo",
  "version": "0.3.1",
  "description": "监控 OpenAI 账号周额度重置，并安全同步关联 Client Key 的周额度账本",
  "license": "Apache-2.0",
  "author": "huhengbo",
  "engines": {
    "codex-proxy-rs": ">=3.17.0, <4.0.0"
  },
  "main": "bin/plugin",
  "runtime": "trustedProcess",
  "contributes": {
    "maintenance": {},
    "management": {}
  },
  "permissions": [
    "data",
    "key_budgets",
    "quota_observations"
  ],
  "configurationSchema": {
    "type": "object",
    "properties": {
      "weeklyWindowSeconds": {
        "type": "integer",
        "minimum": 1,
        "maximum": 2678400,
        "default": 604800,
        "description": "周额度窗口长度，默认 604800 秒"
      },
      "quotaRefreshIntervalSeconds": {
        "type": "integer",
        "minimum": 60,
        "maximum": 86400,
        "default": 300,
        "description": "普通状态下，已有额度观测超过该时长时请求宿主主动刷新"
      },
      "confirmationRefreshIntervalSeconds": {
        "type": "integer",
        "minimum": 30,
        "maximum": 3600,
        "default": 60,
        "description": "发现重置候选后，为取得第二个新样本而主动刷新的最短间隔"
      },
      "maxObservationAgeSeconds": {
        "type": "integer",
        "minimum": 60,
        "maximum": 86400,
        "default": 1800,
        "description": "超过该时间的额度观测不参与重置判断"
      },
      "boundaryGraceSeconds": {
        "type": "integer",
        "minimum": 0,
        "maximum": 3600,
        "default": 300,
        "description": "正常重置边界判断允许的时间误差"
      },
      "earlyResetDropPercent": {
        "type": "number",
        "minimum": 0,
        "maximum": 100,
        "default": 50,
        "description": "未到正常边界时，识别活动/提前恢复所需的最低用量下降百分点"
      },
      "postResetMaxUsedPercent": {
        "type": "number",
        "minimum": 0,
        "maximum": 100,
        "default": 25,
        "description": "候选重置样本允许的最大已用比例"
      },
      "confirmationGrowthPercent": {
        "type": "number",
        "minimum": 0,
        "maximum": 100,
        "default": 20,
        "description": "第二个确认样本相对候选样本允许增长的百分点"
      }
    },
    "additionalProperties": false
  },
  "resources": {
    "web/index.html": "text/html",
    "web/app.js": "text/javascript",
    "web/app.css": "text/css"
  },
  "state": [
    {
      "namespace": "quota_sync",
      "schemaVersion": 1,
      "schema": {
        "type": "object",
        "required": ["accounts", "events", "updatedAtMs"],
        "properties": {
          "settings": {
            "type": "object"
          },
          "accounts": {
            "type": "array",
            "maxItems": 100,
            "items": { "type": "object" }
          },
          "events": {
            "type": "array",
            "maxItems": 64,
            "items": { "type": "object" }
          },
          "updatedAtMs": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "maximumRecords": 1,
      "maximumBytes": 262144,
      "maximumValueBytes": 262144,
      "migratesFrom": []
    }
  ]
}
